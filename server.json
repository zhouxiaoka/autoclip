{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zhouxiaoka/autoclip-mcp",
  "title": "AutoClip",
  "description": "Clip long videos into short clips with covers and captions. Local CLI and MCP.",
  "version": "1.5.7.post1",
