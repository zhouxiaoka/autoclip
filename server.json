  "repository": {
    "url": "https://github.com/zhouxiaoka/autoclip",
    "source": "github",
    "id": "1015815983"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "autoclip-mcp",
      "version": "1.5.7.post1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AUTOCLIP_API_KEY",
          "description": "Model API key. Optional when desktop settings already include one.",
          "isRequired": false,
          "isSecret": true
