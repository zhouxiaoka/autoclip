# Pinned Desktop Build toolchain. Exact versions only: no floating channels.
# Rustup action SHA is the dtolnay/rust-toolchain commit that installed rustc
# 1.100.0 on Desktop Build run 44232757825. toolchain 1.100.0 is passed through
# unchanged; a bare 1.100 would be rewritten by that action.
RUST_TOOLCHAIN=1.100.0
RUSTUP_ACTION_SHA=39008827e6b4319a349e9a42dfc90579dd25f1ca
NODE_VERSION=20.20.2
TAURI_CLI_VERSION=2.12.5
MACOS_RUNNER=macos-15
WINDOWS_RUNNER=windows-latest
MACOS_TARGET=aarch64-apple-darwin
WINDOWS_TARGET=x86_64-pc-windows-msvc
