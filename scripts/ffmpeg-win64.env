# Pinned Windows x64 ffmpeg: the ONLY place these values live. Read by
# scripts/build_windows_x64.sh and .github/actions/setup-ffmpeg-win.
# Source: GyanD/codexffmpeg release 9.0.2 (gyan.dev essentials build). sha256
# checked 2026-10-17: local sha256sum = GitHub asset digest = gyan.dev .sha256.
#
# Reader rule (scripts/lib/ffmpeg_pin.sh and .ps1, identical; tested by
# scripts/tests/test_ffmpeg_pin_reader.py): no UTF-8 BOM; one trailing CR per
# line is dropped; empty lines and lines starting with '#' are skipped; every
# other line must match ^(FFMPEG_VERSION|FFMPEG_URL|FFMPEG_SHA256)=[!-~]+$
# (case-sensitive, printable ASCII, no spaces) and each key appears exactly once.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://github.com/GyanD/codexffmpeg/releases/download/9.0.2/ffmpeg-9.0.2-essentials_build.zip
FFMPEG_SHA256=60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba
