# Pinned macOS Intel (x86_64) ffmpeg + ffprobe: the ONLY place these values live.
# Read by scripts/build_macos_intel.sh.
# Source: ffmpeg.martin-riedl.de static release build 9.0.2 (amd64), the same
# ffmpeg version as scripts/ffmpeg-win64.env. Each zip holds one static binary
# (links only /usr/lib and /System frameworks). sha256 checked 2026-10-17:
# local sha256sum = the publisher's <file>.zip.sha256 (same host).
#
# Reader rule: see scripts/ffmpeg-win64.env (same readers, scripts/lib/ffmpeg_pin.*);
# here the allowed keys are FFMPEG_VERSION, FFMPEG_URL, FFMPEG_SHA256,
# FFPROBE_URL and FFPROBE_SHA256, each exactly once.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip
FFMPEG_SHA256=7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4
FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffprobe.zip
FFPROBE_SHA256=2322438ed2f6319a691291b247d09c69dcaa3a982460d1f269a7e1af335cfdfd
