# Pinned macOS Apple Silicon (arm64) ffmpeg + ffprobe: the ONLY place these values live.
# Read by scripts/build_macos_arm.sh.
# Source: ffmpeg.martin-riedl.de static release build 9.0.2 (arm64), the same
# ffmpeg version as scripts/ffmpeg-win64.env. Each zip holds one static binary
# (links only /usr/lib and /System frameworks). sha256 checked 2026-10-17:
# local sha256sum = the publisher's <file>.zip.sha256 (same host).
#
# Reader rule: see scripts/ffmpeg-win64.env (same readers, scripts/lib/ffmpeg_pin.*);
# here the allowed keys are FFMPEG_VERSION, FFMPEG_URL, FFMPEG_SHA256,
# FFPROBE_URL and FFPROBE_SHA256, each exactly once.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip
FFMPEG_SHA256=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffprobe.zip
FFPROBE_SHA256=fcbe839537485eaee7a7a8bc5cbc0f90d53617e80943e8a5b2e31cb851197ea6
