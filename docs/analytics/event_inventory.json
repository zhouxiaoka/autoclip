  "dates": {
    "plan_effective": "2026-10-14",
    "close_transition": "1.5.8",
    "stop_legacy_emit": "1.5.8",
    "delete_wrappers": "1.5.8"
  },
  "ignore": ["$pageview", "$identify", "survey shown", "survey sent", "survey dismissed"],
  "privacy": {
    "user_content_keys": ["text", "contact"],
    "user_submitted_events": ["feedback_submitted"]
  },
  "transition": {
    "milestone": "1.5.8",
    "keep_query_maps": true,
    "note": "Query maps stay for 1.5.7 history. Producers must be single-track in 1.5.8.",
    "tasks": {
      "single_os_enum": {
        "title": "Single os enum across all producers",
        "send": ["macos", "windows", "linux"],
        "fallback": ["unknown"],
        "forbid": ["darwin", "win32"],
        "accept": "Analytics producer os allowlists contain macos/windows/linux only; no darwin or win32"
      },
      "single_outcome_enum": {
        "title": "Single outcome enum",
        "send": ["success", "error", "partial"],
        "allow_extra": ["recommended", "auto_started", "manual", "fallback", "blocked", "skipped"],
        "forbid": ["completed"],
        "accept": "Producer outcome allowlists send success/error/partial (plus screen/experience extras), not completed"
      },
      "app_version_only": {
        "title": "app_version everywhere; no bare version",
        "field": "app_version",
        "forbid": ["version"],
        "accept": "app_installed, app_opened, and MCP do not send a version property"
      },
      "common_envelope": {
        "title": "Common envelope on QA/MCP/feedback",
        "envelope": ["app_version", "os", "analytics_environment", "runtime", "schema_version"],
        "paths": ["studio_qa_checked", "mcp_tool_called", "mcp_job_finished", "feedback_opened", "feedback_dismissed", "feedback_submitted"],
        "accept": "QA/MCP call envelope_properties(). Feedback capture payload includes the same envelope fields. feedback_submitted may POST /capture/ with user-authored text/contact"
      },
      "legacy_stopped_or_tagged": {
        "title": "Legacy events stopped or tagged legacy=true",
        "accept": "Any still-emitted section 8.2/8.3 event includes legacy=true; dead wrappers deleted in 1.5.8"
      }
    }
  },
