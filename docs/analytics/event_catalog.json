          "minimum": 1
        },
        "secondary_error_codes": {
          "description": "R23 #228: error_code of the other failed goals of a multi-goal attempt (primary is error_code), in failure order; positional with secondary_upstream_error_types. Not used by the success rate. Values outside the list are sent as unknown; http_4xx/http_5xx also allowed.",
          "values": "studio_error_code",
          "format": "comma_joined",
          "max_items": 3
        },
        "secondary_upstream_error_types": {
          "description": "R23 #228: upstream_error_type of each secondary cause, same positions as secondary_error_codes; empty slot when the cause has none or it is not in the list.",
          "values": "upstream_error_type",
          "format": "comma_joined",
          "max_items": 3
        },
        "trigger": {
          "description": "Backend AttemptReceipt trigger, copied from the receipt. 1.5.7 emits initial, retry, and variant_retry. append_platform stays in the enum and is not emitted (append-platform is a 1.5.9 follow-up).",
          "values": "attempt_trigger"
        },
        "prompt_tokens": {
          "description": "Run total. Non-negative integer; the name contains prompt but the value is a count, not user text.",
          "format": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "description": "Run total. Non-negative integer.",
          "format": "integer",
          "minimum": 0
        },
        "llm_calls": {
