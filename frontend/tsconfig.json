{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2015", "ES2016", "ES2017", "ES2018", "ES2019"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@provider-presets": ["../backend/presets/provider_presets.json"],
      "@event-catalog": ["../backend/core/event_catalog.json"],
      "@failure-messages": ["../backend/core/failure_messages.json"]
    }
  },
  "include": ["src", "../backend/presets/provider_presets.json", "../backend/core/event_catalog.json", "../backend/core/failure_messages.json"],
  "references": [{ "path": "./tsconfig.node.json" }]
}